generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hotel {
  id       String @id @default(cuid())
  name     String
  location String
  phone    String
  rooms    Room[]
}

model Room {
  id          String @id @default(cuid())
  type        String
  price       Int
  totalRooms  Int
  bookedRooms Int @default(0)

  hotelId     String   

  hotel       Hotel    @relation(fields: [hotelId], references: [id])

  bids        Bid[]
}

model Bid {
  id        String   @id @default(cuid())
  name      String
  phone     String
  amount    Int
  status    String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | BOOKED

  room      Room     @relation(fields: [roomId], references: [id])
  roomId    String

  createdAt DateTime @default(now())
}